{
  "hosting": {
    "site": "congress-pull",
    "public": "frontend/dist",
    "rewrites": [
      {
        "source": "/api{,/**}",
        "run": {
          "serviceId": "pull-api",
          "region": "us-east1",
          "pinTag": true
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
