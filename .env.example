# Copy this file to .env at the repo root and fill in the values. Never commit .env.
# Variables starting with VITE_ are bundled into the browser app, so a secret must never use that prefix.

# Congress.gov API key from https://api.congress.gov/sign-up/
CONGRESS_API_KEY=

# Postgres connection string from Supabase. Leave it blank until the database exists.
DATABASE_URL=

# Firebase project ID, which the API uses to verify login tokens
FIREBASE_PROJECT_ID=

# Firebase web config for the React app. These identify the project and are not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
