# Copy this file to .env at the repo root and fill in the values. Never commit .env.
# Variables starting with VITE_ are bundled into the browser app, so a secret must never use that prefix.

# Get a free Congress.gov API key at https://api.congress.gov/sign-up/
CONGRESS_API_KEY=

# The team's Supabase connection string, sent privately by the teammate who manages it.
DATABASE_URL=

# Each developer creates their own free Gemini key at https://aistudio.google.com/apikey.
# The AI service uses OpenAI's SDK, so another provider needs only a different base URL and model.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-latest

# The API uses the Firebase project ID to verify login tokens.
FIREBASE_PROJECT_ID=

# The React app reads these Firebase web settings, which identify the project and are not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
