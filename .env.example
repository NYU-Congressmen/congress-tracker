# Copy this file to .env at the repo root and fill in the values. Never commit .env.
# Variables starting with VITE_ are bundled into the browser app, so a secret must never use that prefix.

# Get a free Congress.gov API key at https://api.congress.gov/sign-up/
CONGRESS_API_KEY=

# Set this to the Postgres connection string from Supabase once the database exists.
DATABASE_URL=

# The API uses the Firebase project ID to verify login tokens.
FIREBASE_PROJECT_ID=

# The React app reads these Firebase web settings, which identify the project and are not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
